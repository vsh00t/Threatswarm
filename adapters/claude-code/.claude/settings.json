    "deny": [
      "Bash(rm -rf *)",
      "Bash(shred *)",
      "Bash(wipe *)",
      "Bash(dd if=/dev/zero *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/scope_check.py",
            "timeout": 10,
            "statusMessage": "Checking scope..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/cmd_log.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/findings_sync.py",
            "timeout": 30,
            "statusMessage": "Syncing findings..."
          }
        ]
      }
    ]
  },
  "env": {
    "SCOPE_FILE": "./scope.txt",
    "EVIDENCE_DIR": "./evidence",
    "LHOST": "10.10.14.1",
    "LPORT": "4444",
    "WORDLISTS": "/usr/share/seclists",
    "PYTHONIOENCODING": "utf-8"
  }
}
