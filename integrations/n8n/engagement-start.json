{
  "name": "ThreatSwarm — Engagement Start",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "engagement-start",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "threatswarm-engagement-start"
    },
    {
      "parameters": {
        "jsCode": "// Parse engagement details from webhook payload\nconst body = $input.first().json.body || {};\nconst engagement = body.engagement || 'untitled';\nconst client = body.client || 'unknown';\nconst timestamp = new Date().toISOString();\n\nreturn [{\n  json: {\n    engagement,\n    client,\n    timestamp,\n    baseDir: `/data/threatswarm/${engagement}`,\n    evidenceDir: `/data/threatswarm/${engagement}/evidence`,\n    reportsDir: `/data/threatswarm/${engagement}/reports`,\n    scopeFile: `/data/threatswarm/${engagement}/scope.txt`,\n  }\n}];"
      },
      "id": "parse-payload",
      "name": "Parse Engagement Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "command": "mkdir -p {{$json.evidenceDir}} {{$json.reportsDir}}/{{$json.engagement}}_screenshots {{$json.reportsDir}}/{{$json.engagement}}_exports && echo '# ThreatSwarm Scope\\n# Engagement: {{$json.engagement}}\\n# Client: {{$json.client}}\\n# Created: {{$json.timestamp}}\\n\\n# Add targets below (one per line):\\n# IP addresses, CIDR ranges, or domains\\n' > {{$json.scopeFile}}"
      },
      "id": "create-dirs",
      "name": "Create Directory Structure",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [690, 200]
    },
    {
      "parameters": {
        "command": "echo '{\"version\": \"1.0\", \"engagement\": \"{{$json.engagement}}\", \"client\": \"{{$json.client}}\", \"created\": \"{{$json.timestamp}}\", \"status\": \"active\", \"findings\": []}' > {{$json.evidenceDir}}/evidence_manifest.json"
      },
      "id": "init-manifest",
      "name": "Initialize Evidence Manifest",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [690, 400]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate results\nconst dirs = $('Create Directory Structure').first().json;\nconst manifest = $('Initialize Evidence Manifest').first().json;\nconst engagement = $input.first().json;\n\nreturn [{\n  json: {\n    ...engagement,\n    dirsCreated: true,\n    manifestCreated: true,\n    status: 'initialized',\n  }\n}];"
      },
      "id": "aggregate",
      "name": "Aggregate Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [910, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot{{$credentials.telegramBotToken}}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{$credentials.telegramChatId}}\",\n  \"text\": \"🜏 *ThreatSwarm — Engagement Started*\\n\\n📌 *Engagement:* {{$json.engagement}}\\n🏢 *Client:* {{$json.client}}\\n📁 *Base Dir:* `{{$json.baseDir}}`\\n⏰ *Time:* {{$json.timestamp}}\\n\\nDirectory structure created. Add targets to scope.txt to begin testing.\",\n  \"parse_mode\": \"Markdown\"\n}",
        "options": {}
      },
      "id": "telegram-notify",
      "name": "Telegram Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1130, 300],
      "credentials": {
        "telegramApi": {
          "id": "PLACEHOLDER_CREDENTIAL_ID",
          "name": "Telegram Bot API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"ok\",\n  \"engagement\": \"{{$json.engagement}}\",\n  \"baseDir\": \"{{$json.baseDir}}\",\n  \"message\": \"Engagement directory structure created successfully\"\n}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1350, 300]
    }
  ],
